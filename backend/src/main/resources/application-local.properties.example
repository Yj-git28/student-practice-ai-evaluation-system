# ============================================================================
# 本地开发配置样例
# 用法：把本文件复制为同目录下的 application-local.properties，再填入本机真实值
#   cp application-local.properties.example application-local.properties
# application-local.properties 已被 .gitignore 忽略，密码/密钥不会提交到仓库
# ============================================================================

# ===== MySQL（先按 docs/backend/sql 目录下的脚本顺序建好库和表）=====
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/training_eval?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
spring.datasource.username=root
spring.datasource.password=请填写本机 MySQL 密码

# ===== Redis（需支持 Stream：Redis 5+，推荐 7）=====
spring.data.redis.host=127.0.0.1
spring.data.redis.port=6379
spring.data.redis.password=

# ===== JWT =====
# HS256 要求密钥长度 >= 32 字节；上线前务必换成随机长串，不要沿用这里的占位值
app.jwt.secret=请替换为至少32位的随机字符串_例如abcdefghijklmnopqrstuvwxyz1234567890
app.jwt.expire-seconds=28800

# ===== 邮件验证码 =====
# 四项留空 → mock 模式，验证码输出到后端日志（[EMAIL-MOCK]），不真实发信
# 填齐后才走 JavaMailSender 真实发送；QQ/163 用授权码（非登录密码），端口 465 走 SSL
spring.mail.host=
spring.mail.port=465
spring.mail.username=
spring.mail.password=
app.mail.from=

# ===== 成果上传目录（相对项目根目录）=====
app.upload.dir=uploads

# ===== 消息队列（Redis Stream）=====
# true：提交后异步评分（先返回 QUEUED）；false：退回同步算分
app.mq.enabled=true
